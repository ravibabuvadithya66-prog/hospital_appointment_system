<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hospital Appointment System</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body>
<header><a class="brand" href="${pageContext.request.contextPath}/appointments">✚ CarePoint <small>Hospital Appointment System</small></a><nav><a href="#doctors">Doctors</a><a href="#book">Book</a><a href="#appointments">Appointments</a></nav></header><main>
<section class="hero"><div><p class="eyebrow">YOUR HEALTH, OUR PRIORITY</p><h1>Healthcare made<br><span>simple.</span></h1><p>Find a doctor, choose a convenient time, and manage appointments in one place.</p><a class="btn" href="#book">Book an appointment →</a></div><aside><div class="plus">✚</div><p class="eyebrow">CARE THAT FITS YOUR LIFE</p><h2>Book your visit<br>in minutes.</h2><b>6 Specialists · Easy Booking</b></aside></section>
<c:if test="${not empty param.message}"><div class="notice"><c:choose><c:when test="${param.message=='booked'}">Appointment booked successfully!</c:when><c:when test="${param.message=='cancelled'}">Appointment cancelled.</c:when><c:when test="${param.message=='slot'}">This doctor already has a booking at that time. Select another slot.</c:when><c:when test="${param.message=='invalid'}">Please enter valid details in all required fields.</c:when><c:when test="${param.message=='past'}">Choose today or a future date.</c:when><c:otherwise>Could not complete request. Check your database connection.</c:otherwise></c:choose></div></c:if>
<c:if test="${not empty error}"><div class="error"><c:out value="${error}"/></div></c:if>
<section id="doctors"><p class="eyebrow">OUR SPECIALISTS</p><h2>Choose your doctor</h2><div class="cards"><c:forEach var="d" items="${doctors}"><article><div class="avatar">✚</div><h3><c:out value="${d.name}"/></h3><p><c:out value="${d.specialty}"/></p><a href="#book">Book with doctor ↓</a></article></c:forEach></div></section>
<section id="book"><p class="eyebrow">GET STARTED</p><h2>Book an appointment</h2><form action="${pageContext.request.contextPath}/appointments" method="post"><div class="grid">
<label>Patient name<input name="patientName" required minlength="2" placeholder="Full name"></label><label>Phone number<input name="phone" required pattern="[0-9]{10}" maxlength="10" placeholder="10-digit mobile"></label>
<label>Email address<input name="email" type="email" required placeholder="you@example.com"></label><label>Choose doctor<select name="doctorId" required><option value="">Select doctor</option><c:forEach var="d" items="${doctors}"><option value="${d.id}"><c:out value="${d.name}"/> — <c:out value="${d.specialty}"/></option></c:forEach></select></label>
<label>Appointment date<input name="appointmentDate" type="date" min="<%= java.time.LocalDate.now() %>" required></label><label>Preferred time<select name="appointmentTime" required><option value="">Select time</option><option>09:00 AM</option><option>10:00 AM</option><option>11:00 AM</option><option>12:00 PM</option><option>02:00 PM</option><option>03:00 PM</option><option>04:00 PM</option></select></label>
<label class="wide">Reason for visit<textarea name="reason" rows="3" maxlength="500" placeholder="Optional"></textarea></label></div><button class="btn">Confirm appointment →</button><p class="hint">Educational demo only. Do not enter real patient information.</p></form></section>
<section id="appointments"><p class="eyebrow">YOUR BOOKINGS</p><h2>All appointments</h2><div class="tablewrap"><table><thead><tr><th>Patient</th><th>Doctor</th><th>Date</th><th>Time</th><th>Phone</th><th>Action</th></tr></thead><tbody><c:forEach var="a" items="${appointments}"><tr><td><c:out value="${a.patientName}"/></td><td><c:out value="${a.doctorName}"/><small><c:out value="${a.specialty}"/></small></td><td><c:out value="${a.appointmentDate}"/></td><td><c:out value="${a.appointmentTime}"/></td><td><c:out value="${a.phone}"/></td><td><a class="cancel" href="${pageContext.request.contextPath}/appointments?delete=${a.id}" onclick="return confirm('Cancel this appointment?')">Cancel</a></td></tr></c:forEach><c:if test="${empty appointments}"><tr><td colspan="6">No appointments yet.</td></tr></c:if></tbody></table></div></section>
</main><footer>✚ CarePoint <span>FSD-II Mini Project · Java, JSP, JDBC and MySQL</span></footer></body></html>
